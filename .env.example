# Copie para .env e preencha. O .env nunca vai para o Git.

# Senha de app do Gmail (não é a sua senha normal):
# 1. Ative a verificação em 2 etapas: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Crie a senha de app:            https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Opcionais
# PORT=4321                # porta do painel
# SEND_INTERVAL_SEC=90     # intervalo mínimo entre e-mails no envio em lote
# MAX_SENDS_PER_RUN=20     # limite por rodada no "npm run apply -- --send"
