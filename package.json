  "author": "Flavia Machado Martini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlaviaMMartini/hunter-vagas.git"
  },
  "homepage": "https://github.com/FlaviaMMartini/hunter-vagas#readme",
  "bugs": "https://github.com/FlaviaMMartini/hunter-vagas/issues",
  "keywords": [
    "vagas",
    "emprego",
    "job-search",
    "gupy",
    "inhire",
    "greenhouse",
    "ocr",
    "gmail",
    "nodejs",
    "zero-dependencies"
  ]
}
