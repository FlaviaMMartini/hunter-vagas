{
  "name": "hunter-vagas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js --abrir",
    "painel": "node --env-file-if-exists=.env src/server.js",
    "hunt": "node --env-file-if-exists=.env src/hunt.js",
    "respostas": "node --env-file-if-exists=.env src/check-responses.js",
    "apply": "node --env-file-if-exists=.env src/apply.js",
    "agendar": "node src/schedule.js",
    "desagendar": "node src/schedule.js --remover",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Agente que busca vagas de tecnologia em várias plataformas, filtra pelo seu perfil, escreve candidaturas e acompanha as respostas no Gmail.",
